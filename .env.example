NODE_ENV=development
PORT=3001

# Postgres. Ports are non-default so a local install does not collide.
DATABASE_URL=postgresql://rakuxon:rakuxon@localhost:5433/rakuxon
DATABASE_SSL=false

REDIS_URL=redis://localhost:6380

# Access tokens are short; refresh tokens rotate and are single-use.
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_REFRESH_SECRET=change-me-too-and-make-it-different
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Where the FE lives, for CORS and for links in emails.
WEB_APP_URL=http://localhost:3000

# Optional. Without these, /v1/auth/sso/google/callback answers 400 rather
# than the process refusing to start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
