NODE_ENV=development
PORT=3001

# Postgres. Ports are non-default so a local install does not collide.
DATABASE_URL=postgresql://rakuxon:rakuxon@localhost:5433/rakuxon
DATABASE_SSL=false
# Temporary opt-in: allows TypeORM to alter entity tables at startup.
DATABASE_SYNCHRONIZE=false

REDIS_URL=redis://localhost:6380

# Access tokens are short; refresh tokens rotate and are single-use.
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_REFRESH_SECRET=change-me-too-and-make-it-different
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Canonical web address, used for links in emails.
WEB_APP_URL=http://localhost:3000

# Every browser origin allowed to call the API. The frontend is five apps on
# five ports, so one origin is never enough. WEB_APP_URL is always included.
CORS_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:3004

# Optional. Without these, /v1/auth/sso/google/callback answers 400 rather
# than the process refusing to start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where each audience signs in. A reset link must land on the surface that
# person uses; each falls back to WEB_APP_URL.
PARTNER_APP_URL=http://localhost:3002
INSTITUTION_APP_URL=http://localhost:3003
ADMIN_APP_URL=http://localhost:3004

# Optional. Without SMTP_HOST and SMTP_FROM, emails (password reset, email
# verification) are logged instead of sent — see LoggingNotificationAdapter.
# Any SMTP account works: Gmail, SendGrid/SES's SMTP relay, or Mailtrap for a
# local inbox that never reaches a real person.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false (the default) for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Rakuxon <no-reply@rakuxon.com>"
